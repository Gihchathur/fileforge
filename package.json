{
  "name": "fileforge",
  "displayName": "FileForge - Project File Tree",
  "description": "Export and import project file trees in VS Code.",
  "version": "0.1.3",
  "publisher": "GihanChathuranga",
  "icon": "images/fileforge-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gihchathur/fileforge.git"
  },
  "homepage": "https://github.com/Gihchathur/fileforge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fileforge.scanWorkspace",
        "title": "FileForge: Scan Workspace"
      },
      {
        "command": "fileforge.copyStructure",
        "title": "FileForge: Copy Structure"
      },
      {
        "command": "fileforge.importStructure",
        "title": "FileForge: Import Structure"
      },
      {
        "command": "fileforge.copyJsonWithContent",
        "title": "FileForge: Copy JSON With Content"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fileforge",
          "title": "FileForge",
          "icon": "$(file-directory)"
        }
      ]
    },
    "views": {
      "fileforge": [
        {
          "id": "fileforge.mainView",
          "name": "FileForge"
        }
      ]
    },
    "configuration": {
      "title": "FileForge",
      "properties": {
        "fileforge.ignoreDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            "dist",
            "build",
            "coverage",
            ".next",
            ".nuxt",
            ".vscode",
            "bin",
            "obj"
          ],
          "description": "Directory names excluded when scanning a workspace."
        },
        "fileforge.sensitiveFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".env",
            ".env.local",
            ".env.development",
            ".env.production",
            ".env.test",
            "credentials.json",
            "secrets.json",
            "service-account.json",
            "id_rsa",
            "id_rsa.pub",
            "id_dsa",
            "id_ecdsa",
            "id_ed25519",
            "private.key",
            "private.pem"
          ],
          "description": "File names whose contents are redacted when exporting JSON with file contents."
        },
        "fileforge.maxContentFileSize": {
          "type": "number",
          "default": 1048576,
          "minimum": 0,
          "description": "Maximum file size in bytes whose contents can be exported as JSON. Files larger than this limit are not exported."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
